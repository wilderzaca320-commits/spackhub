# Puerto del servidor principal (Express + API + app compilada)
PORT=3000

# Interfaz de red: 127.0.0.1 = solo esta PC; 0.0.0.0 = accesible desde la red local.
HOST=127.0.0.1

# Cuenta administradora que se crea/actualiza al arrancar.
# Nadie puede registrarse como admin desde la interfaz.
ADMIN_EMAIL=admin@sparkhub.local
ADMIN_PASSWORD=Admin12345

# Secreto para firmar el JWT de sesión. Cambialo por una cadena larga y aleatoria.
JWT_SECRET=cambia-este-secreto-por-una-cadena-larga-y-aleatoria

# Clave de Gemini (solo servidor). Si queda vacía, /api/generate responde un mock.
GEMINI_API_KEY=

# Modelo de Gemini usado por /api/generate (opcional).
GEMINI_MODEL=gemini-2.0-flash

# Portada de presentación (servidor 4321). /portada redirige aquí.
PORTADA_URL=http://127.0.0.1:4321/

# Opcional: ruta alternativa para la base SQLite.
# DB_PATH=./server/data/sparkhub.db
